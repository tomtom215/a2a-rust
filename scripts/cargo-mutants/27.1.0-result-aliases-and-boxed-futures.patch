+/// True when a replacement's text is the function body's, allowing for the
+/// spellings of a boxed future that differ only in ways that cannot change
+/// what it yields: `async` and `async move` around a replacement, which is
+/// always a constant expression and so captures nothing, and an `async` block
+/// written `{}` or `{ () }`.
+fn same_body_text(orig: &str, replacement: &str) -> bool {
+    fn normalize(s: &str) -> String {
+        s.replace("async move", "async").replace("{()}", "{}")
+    }
+    orig == replacement || normalize(orig) == normalize(replacement)
+}
