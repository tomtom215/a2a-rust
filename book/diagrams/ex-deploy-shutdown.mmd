flowchart TB
    sig["SIGTERM"]
    d["Not ready, still serving:<br/>drain delay, 5 s"]
    a["Tasks get 5 s to finish,<br/>then 10 s after cancellation"]
    c["Connections drain:<br/>up to 10 s, then cleanup<br/>and claim release: up to 5 s"]
    e["Telemetry flush: up to 15 s"]
    x["Process exits,<br/>before SIGKILL at 60 s"]
    sig --> d --> a --> c --> e --> x
