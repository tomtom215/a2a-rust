flowchart TB
    caller["Callers, at AGENT_URL"]
    svc["Service :80"]
    kubelet["kubelet probes<br/>/health and /ready"]
    p1["Pod 1<br/>[::]:8080"]
    p2["Pod 2<br/>[::]:8080"]
    pg[("PostgreSQL<br/>DATABASE_URL")]
    caller --> svc
    svc --> p1
    svc --> p2
    kubelet -.-> p1
    kubelet -.-> p2
    p1 --> pg
    p2 --> pg
