FROM rust:1.99.1-alpine@sha256:b1d5dd5a22a09404d3e798c0cf051b689077360374eb505fa5bb93c479693d87 AS build
RUN apk add --no-cache musl-dev protoc
WORKDIR /src
COPY . .
RUN cargo build --release -p echo-agent

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY --from=build /src/target/release/echo-agent /agent
ENV A2A_BIND_ADDR=0.0.0.0:9104
EXPOSE 9104
CMD ["/agent"]
