/target
# Out-of-workspace binding crates keep their own target/ (and their own lock).
bindings/*/target/

# mdBook build output
/book/book

# Environment secrets
.env
.env.*

# IDE directories
.idea/
.vscode/
*.iml

# macOS artifacts
.DS_Store

# Editor swap files
*.swp
*.swo

# Benchmark results (keep .gitkeep)
benches/results/*.json
benches/results/*.md
!benches/results/.gitkeep
# The cross-language results are an exception: book/src/reference/
# cross-language-benchmarks.md is generated from them and claims to be
# auditable against them, which it is not if they are untracked. They are
# ~11 KB each and are rewritten, not appended, by each run.
!benches/results/cross-language-*.json

# Python bytecode cache
__pycache__/
*.pyc

# ITK agent build artifacts
node_modules/
itk/agents/go-agent/go-agent
itk/agents/js-agent/package-lock.json

# cargo-mutants output
mutants.out/
mutants.out.old/
/itk/target
# The upstream ITK checkout that itk/run_itk.sh clones next to itself.
/itk/a2a-itk
/itk/run_request.json
/itk/raw_results.json
/itk/itk_rust.json
/itk/logs
fuzz/corpus/
fuzz/artifacts/
fuzz/target/

# ITK official-SDK agent build artifacts
itk/agents/java-sdk/target/
itk/agents/go-sdk/a2a-itk-go-sdk-agent
itk/agents/*/node_modules/
