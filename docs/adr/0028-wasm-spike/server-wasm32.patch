@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 Tom F. <tomf@tomtomtech.net> (https://github.com/tomtom215)
+
+//! Timers for a Worker: one `setTimeout` per sleep, armed from the request
+//! that polls it and cleared when the sleep is dropped.
+//!
+//! The futures are `Send`, which the crate's traits require, though nothing
+//! here leaves the one thread an isolate has: the JavaScript closure that
+//! wakes a sleep lives in a thread-local table, and the sleep holds only its
+//! id and an `Arc` of shared state.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll, Waker};
+use std::time::Duration;
+
+use wasm_bindgen::prelude::*;
+use web_time::Instant;
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_name = setTimeout)]
+    fn set_timeout(callback: &js_sys::Function, milliseconds: f64) -> i32;
+    #[wasm_bindgen(js_name = clearTimeout)]
+    fn clear_timeout(id: i32);
+}
+
+thread_local! {
+    /// The closures of timers that are armed, by `setTimeout` id. Held here,
+    /// not in the `Sleep`, so a `Sleep` is `Send`; dropped by the `Sleep`
+    /// after it fires or is cancelled, never from inside the callback.
+    static ARMED: RefCell<HashMap<i32, Closure<dyn FnMut()>>> = RefCell::new(HashMap::new());
+}
+
+#[derive(Default)]
+struct Shared {
+    fired: bool,
+    waker: Option<Waker>,
+}
+
+/// Completes once its deadline has passed.
+pub(crate) struct Sleep {
+    deadline: Instant,
+    shared: Arc<Mutex<Shared>>,
+    id: Option<i32>,
+}
+
+/// Completes at `Instant::now() + duration`.
+pub(crate) fn sleep(duration: Duration) -> Sleep {
+    Sleep::until(Instant::now() + duration)
+}
+
+impl Sleep {
+    fn until(deadline: Instant) -> Self {
+        Self {
+            deadline,
+            shared: Arc::default(),
+            id: None,
+        }
+    }
+
+    /// Moves the deadline, as `tokio::time::Sleep::reset` does.
+    pub(crate) fn reset(mut self: Pin<&mut Self>, deadline: Instant) {
+        let this = &mut *self;
+        this.disarm();
+        this.deadline = deadline;
+        this.shared = Arc::default();
+    }
+
+    fn arm(&mut self) {
+        let remaining = self.deadline.saturating_duration_since(Instant::now());
+        // `setTimeout` fires at once above `i32::MAX` ms, so wait in steps:
+        // the callback re-checks the deadline, below.
+        let ms = remaining.as_millis().min(i32::MAX as u128) as f64;
+        let shared = Arc::clone(&self.shared);
+        let closure = Closure::<dyn FnMut()>::new(move || {
+            let mut shared = shared.lock().expect("timer state");
+            shared.fired = true;
+            if let Some(waker) = shared.waker.take() {
+                waker.wake();
+            }
+        });
+        let id = set_timeout(closure.as_ref().unchecked_ref(), ms);
+        ARMED.with(|armed| armed.borrow_mut().insert(id, closure));
+        self.id = Some(id);
+    }
+
+    fn disarm(&mut self) {
+        if let Some(id) = self.id.take() {
+            clear_timeout(id);
+            ARMED.with(|armed| armed.borrow_mut().remove(&id));
+        }
+    }
+}
+
+impl Future for Sleep {
+    type Output = ();
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        let this = &mut *self;
+        if Instant::now() >= this.deadline {
+            this.disarm();
+            return Poll::Ready(());
+        }
+        let fired = {
+            let mut shared = this.shared.lock().expect("timer state");
+            let fired = std::mem::take(&mut shared.fired);
+            shared.waker = Some(cx.waker().clone());
+            fired
+        };
+        // Fired but the clock has not reached the deadline (a step of a long
+        // wait, or a clock that only advances between events): arm again.
+        if this.id.is_none() || fired {
+            this.disarm();
+            this.arm();
+        }
+        Poll::Pending
+    }
+}
+
+impl Drop for Sleep {
+    fn drop(&mut self) {
+        self.disarm();
+    }
+}
+
+/// A future that did not finish in time.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Elapsed;
+
+impl std::fmt::Display for Elapsed {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("deadline has elapsed")
+    }
+}
+
+impl std::error::Error for Elapsed {}
+
+/// `future`, unless `duration` passes first.
+pub(crate) fn timeout<F: Future>(duration: Duration, future: F) -> Timeout<F> {
+    timeout_at(Instant::now() + duration, future)
+}
+
+/// `future`, unless `deadline` passes first.
+pub(crate) fn timeout_at<F: Future>(deadline: Instant, future: F) -> Timeout<F> {
+    Timeout {
+        future: Box::pin(future),
+        sleep: Sleep::until(deadline),
+    }
+}
+
+pub(crate) struct Timeout<F: Future> {
+    future: Pin<Box<F>>,
+    sleep: Sleep,
+}
+
+impl<F: Future> Future for Timeout<F> {
+    type Output = Result<F::Output, Elapsed>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = &mut *self;
+        // The future first, as tokio does: one that is ready is not lost to a
+        // deadline that passed while it was.
+        if let Poll::Ready(out) = this.future.as_mut().poll(cx) {
+            return Poll::Ready(Ok(out));
+        }
+        match Pin::new(&mut this.sleep).poll(cx) {
+            Poll::Ready(()) => Poll::Ready(Err(Elapsed)),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+/// What tokio's interval does for ticks it missed. Kept so call sites that
+/// name it build; only `Delay` is implemented, the others behave as it does.
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum MissedTickBehavior {
+    Delay,
+}
+
+/// Ticks every `period`, the first at once.
+pub(crate) struct Interval {
+    period: Duration,
+    next: Instant,
+}
+
+pub(crate) fn interval(period: Duration) -> Interval {
+    Interval {
+        period,
+        next: Instant::now(),
+    }
+}
+
+impl Interval {
+    pub(crate) fn set_missed_tick_behavior(&mut self, _behavior: MissedTickBehavior) {}
+
+    pub(crate) async fn tick(&mut self) {
+        Sleep::until(self.next).await;
+        self.next = Instant::now().max(self.next) + self.period;
+    }
+}
