+//! On a native target these are Tokio's. On `wasm32-unknown-unknown`, which has
+//! no Tokio runtime, no sockets, no threads, and where `std::time::Instant` and
+//! `SystemTime` panic, they are the JavaScript event loop's: tasks run through
+//! `wasm_bindgen_futures::spawn_local`, timers through `setTimeout`
+//! (`wasmtimer`), and the clock is `performance.now()` / `Date.now()`.
+//!
+//! Two instants are exported because natively they are two types: Tokio's,
+//! which a test can pause and which `timeout_at` takes, and the standard
+//! library's. On wasm both are one type.
+
+#[cfg(not(target_family = "wasm"))]
+pub(crate) use tokio::spawn;
+#[cfg(not(target_family = "wasm"))]
+pub(crate) use tokio::task::JoinHandle;
+
+#[cfg(target_family = "wasm")]
+pub(crate) use tokio_with_wasm::spawn;
+#[cfg(target_family = "wasm")]
+pub(crate) use tokio_with_wasm::task::JoinHandle;
+
+#[cfg(target_family = "wasm")]
+mod timers;
+
+/// A timer an agent can await in a Worker, where Tokio's do not run and a
+/// timer built on `setTimeout` must be armed by the request that awaits it.
+#[cfg(target_family = "wasm")]
+pub async fn sleep(duration: std::time::Duration) {
+    timers::sleep(duration).await;
+}
+
+/// Spawns `future` on `tracker`: what `TaskTracker::spawn` does, but through
+/// [`spawn`], because `TaskTracker::spawn` calls `tokio::spawn` itself and so
+/// needs a Tokio reactor, which a Worker does not have.
+pub(crate) fn spawn_tracked<F>(
+    tracker: &tokio_util::task::TaskTracker,
+    future: F,
+) -> JoinHandle<F::Output>
+where
+    F: std::future::Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    spawn(tracker.track_future(future))
+}
+
+/// Timers and clocks.
+pub(crate) mod time {
+    #[cfg(not(target_family = "wasm"))]
+    pub(crate) use std::time::{Instant as StdInstant, SystemTime, UNIX_EPOCH};
+    #[cfg(not(target_family = "wasm"))]
+    pub(crate) use tokio::time::{Instant, Interval, Sleep, interval, sleep, timeout, timeout_at};
+
+    // Not `wasmtimer`, whose one global timer chain is armed by whichever
+    // request first used a timer and dies with that request's context, so
+    // every later request's timers never fired; and not `tokio_with_wasm`'s,
+    // whose futures are `!Send`, which this crate's traits forbid. See
+    // `timers`.
+    #[cfg(target_family = "wasm")]
+    pub(crate) use super::timers::{
+        Interval, MissedTickBehavior, Sleep, interval, sleep, timeout, timeout_at,
+    };
+    #[cfg(target_family = "wasm")]
+    pub(crate) use web_time::Instant;
+    #[cfg(target_family = "wasm")]
+    pub(crate) use web_time::Instant as StdInstant;
+    #[cfg(not(target_family = "wasm"))]
+    pub(crate) use tokio::time::MissedTickBehavior;
+    #[cfg(target_family = "wasm")]
+    pub(crate) use web_time::{SystemTime, UNIX_EPOCH};
+}
