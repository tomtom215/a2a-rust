+# Native: Tokio with sockets and signals, and hyper's connection-pooling client.
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+tokio      = { workspace = true, features = ["net", "signal"] }
+hyper-util = { workspace = true, features = ["client", "client-legacy"] }
