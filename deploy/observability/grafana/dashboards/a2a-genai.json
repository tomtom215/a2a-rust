      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Model calls and tool calls per run",
      "description": "gen_ai.invoke_agent.inference_calls and .tool_calls: how many rounds a run took. A rising p95 is a model looping on its tools.",
      "datasource": {
        "type": "prometheus",
        "uid": "a2a-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "a2a-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_invoke_agent_inference_calls_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p50 model calls"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "a2a-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_inference_calls_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p95 model calls"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "a2a-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_invoke_agent_tool_calls_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p50 tool calls"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "a2a-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_tool_calls_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "p95 tool calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
