+
+    #[tokio::test]
+    async fn push_config_create_without_task_id_is_invalid_params() {
+        let handler = make_handler();
+        // `taskId` is optional on the wire type, but the JSON-RPC binding has no
+        // path segment to supply it, so a standalone create without one is a
+        // client error. -32602 is the assertion that matters: without the guard
